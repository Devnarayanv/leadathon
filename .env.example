# Copy this file to .env and edit if needed. Defaults work for a normal
# local Ollama install.

# ---------- Local AI (Ollama) ----------
OLLAMA_BASE_URL=http://localhost:11434
# Any model you have pulled. qwen2.5:3b is small and fast enough for a laptop.
OLLAMA_MODEL=qwen2.5:3b
# Model used only when the user switches to Malayalam. Leave empty to use
# OLLAMA_MODEL for both. A model larger than your VRAM runs partly on CPU
# and gets several times slower, so keep the English one small.
OLLAMA_MODEL_ML=gemma2:9b
# Seconds to wait for the model. Raise it if your machine is slow.
OLLAMA_TIMEOUT=240
# Longer budget for the Malayalam model, which is bigger.
OLLAMA_TIMEOUT_ML=420
# Keep the model in RAM between requests so uploads stay fast.
OLLAMA_KEEP_ALIVE=30m

# ---------- Uploads ----------
MAX_UPLOAD_MB=15
# Pages analysed per document.
MAX_PAGES=40

# ---------- OCR (only needed for scans and photos) ----------
# Windows example:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
# Add +mal once the Malayalam traineddata is installed: eng+mal
OCR_LANGS=eng+mal
# Image-only pages sent to OCR per document.
OCR_MAX_PAGES=8
OCR_DPI=200
OCR_MAX_IMAGE_PX=2200

# ---------- Performance ----------
# Clauses that get an AI explanation, in one batched request.
MAX_EXPLAINED_CLAUSES=6
# Fewer for Malayalam, because that model is bigger and slower.
MAX_EXPLAINED_CLAUSES_ML=3
# Output tokens per clause; lower = faster.
CLAUSE_TOKEN_BUDGET=170
# Malayalam needs more tokens per sentence or the JSON gets cut off.
CLAUSE_TOKEN_BUDGET_ML=340
MAX_CLAUSE_CHARS=700
MAX_QA_CONTEXT_CHARS=3500

# ---------- Server ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Leave false. Setting it true would echo document text into server logs.
LOG_DOCUMENT_TEXT=false
